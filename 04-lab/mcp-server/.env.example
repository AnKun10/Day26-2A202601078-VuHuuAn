# WeatherAPI.com key cho MCP server (dữ liệu thời tiết THẬT).
# Lấy free tại: https://www.weatherapi.com/
# BỎ TRỐNG cũng được: server sẽ tự chạy ở DEMO MODE với dữ liệu giả,
# đủ để chạy thử agent end-to-end mà không cần key.
WEATHERAPI_KEY=your_weatherapi_key_here

# (tuỳ chọn) đổi cổng server, mặc định 8085
# PORT=8085
